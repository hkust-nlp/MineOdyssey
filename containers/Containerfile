# 回归我们最初选择的、最稳的 NVIDIA 基础镜像
FROM docker.io/nvidia/opengl:1.2-glvnd-devel-ubuntu22.04

# 1. 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive

# 2. 安装 Java 21、Xvfb、Xorg 和基础依赖
RUN apt-get update && apt-get install -y \
    openjdk-21-jdk \
    python3-pip \
    xvfb \
    xserver-xorg-core \
    xserver-xorg-video-dummy \
    x11-utils \
    x11-apps \
    imagemagick \
    xdotool \
    wget \
    curl \
    file \
    libglu1-mesa \
    libegl1-mesa \
    libgl1-mesa-glx \
    libglx-mesa0 \
    mesa-utils \
    libx11-6 \
    libxext6 \
    libxtst6 \
    kmod \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2.5. 安装 Python 依赖
RUN pip3 install portablemc flask requests openai && portablemc -h

# 2.6. 安装 mcrcon (Minecraft RCON 客户端, 用于 wait_server_ready / data get entity 等)
RUN wget --timeout=30 --tries=3 \
    https://github.com/Tiiffi/mcrcon/releases/download/v0.7.2/mcrcon-0.7.2-linux-x86-64.tar.gz \
    -O /tmp/mcrcon.tgz \
    && tar xzf /tmp/mcrcon.tgz -C /tmp \
    && install -m 0755 /tmp/mcrcon /usr/local/bin/mcrcon \
    && rm -f /tmp/mcrcon.tgz /tmp/mcrcon /tmp/README.md /tmp/LICENSE /tmp/CHANGELOG.md \
    && mcrcon -v

# 3. 安装 VirtualGL (核心补丁)
# 基础镜像提供了驱动接口，VirtualGL 负责把游戏的渲染指令"翻译"给驱动
RUN wget --timeout=30 --tries=3 \
    https://sourceforge.net/projects/virtualgl/files/3.1/virtualgl_3.1_amd64.deb/download \
    -O virtualgl.deb \
    && file virtualgl.deb | grep -q "Debian binary package" \
    && dpkg -i virtualgl.deb \
    && apt-get install -f -y \
    && which vglrun \
    && vglrun --help \
    && rm virtualgl.deb

# 4. 设置环境变量，确保 nvidia-smi 和 vglrun 都能直接用
ENV PATH=$PATH:/opt/VirtualGL/bin
# 将 NVIDIA 库路径放在最前面，确保优先使用 GPU 渲染
ENV LD_LIBRARY_PATH=/usr/lib64:/opt/VirtualGL/lib64:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

# Bypass any host-injected HTTP_PROXY/HTTPS_PROXY for localhost:
# AgentBridge/RCON/remote_bash all listen on 127.0.0.1, so requests must not be proxied.
# Both upper- and lowercase are needed (Python requests honours either).
ENV NO_PROXY=127.0.0.1,localhost,::1
ENV no_proxy=127.0.0.1,localhost,::1

WORKDIR /app


