#!/usr/bin/env python3
"""xdotool wrapper that auto-binds DISPLAY from workspace runtime config."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from typing import List

from mc_runtime import get_display, load_runtime_config


def _run_xdotool(display: str, args: List[str]) -> int:
    if not shutil.which("xdotool"):
        print("xdo error: xdotool not found in PATH", file=sys.stderr)
        return 2
    env = os.environ.copy()
    env["DISPLAY"] = display
    proc = subprocess.run(["xdotool", *args], env=env, capture_output=True, text=True)
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    return proc.returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        description="X11 input CLI (reads DISPLAY from workspace runtime config)"
    )
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Raw xdotool arguments")

    args = parser.parse_args()

    try:
        cfg = load_runtime_config()
        display = get_display(cfg)
    except Exception as e:
        print(f"xdo config error: {e}", file=sys.stderr)
        return 2

    if not args.args:
        print("xdo error: missing xdotool arguments", file=sys.stderr)
        return 2
    return _run_xdotool(display, args.args)


if __name__ == "__main__":
    raise SystemExit(main())
